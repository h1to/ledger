# Copy to .env (git-ignored) and fill in. All values are read from the environment.

# --- Database (the existing Supabase Postgres, or a local Postgres for dev) ---
# Supabase connection string is under Project Settings > Database. Use the JDBC form:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ledger
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Auth ---
# HS256 signing secret. MUST be at least 32 bytes. Generate e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Optional: token lifetime in ms (default 30 days)
# JWT_TTL_MILLIS=2592000000

# --- CORS: the frontend origin(s), comma-separated ---
ALLOWED_ORIGIN=http://localhost:5173

# --- AI advisor (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5
# ADVISOR_DAILY_LIMIT=10

# --- Server ---
# PORT is provided by Render automatically; for local dev the default is 8080.
# PORT=8080
