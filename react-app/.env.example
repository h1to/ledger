# Copy to `.env` and fill in to point the app at your own Supabase project.
# All values are optional: if unset, the app falls back to the embedded defaults
# in src/constants.ts. The publishable (anon) key is safe to expose in the browser —
# Row-Level Security is what protects data. NEVER put an sb_secret_/service_role key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: also email feedback submissions via Web3Forms.
VITE_WEB3FORMS_KEY=

# Optional: set to "blob" to use the legacy single-jsonb cloud store instead of the
# normalized relational tables (this branch defaults to relational).
VITE_CLOUD_DRIVER=
