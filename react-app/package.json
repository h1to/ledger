{
  "name": "ledger-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Money Planner — plan-first personal budgeting, local-first with cloud sync (React port).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
