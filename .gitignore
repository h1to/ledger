# Include your project-specific ignores in this file
# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files
# Useful .gitignore templates: https://github.com/github/gitignore
node_modules
dist
.cache
# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# build & deps (any depth)
**/node_modules/
**/dist/
*.log
*.tsbuildinfo
# Java backend build output
backend/target/
backend/.gradle/

# local env files (never commit real credentials). .env.example IS tracked.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Personal bank statements / debt certificates — never commit (contain IIN & financial data)
*.pdf
**/*.pdf
